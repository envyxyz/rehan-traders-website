// Cloudflare Workers, free plan. The static export in out/ is served as static assets (free, never runs the
// Worker); the Worker runs only for /api/*. Secrets: BOOKING_WEBHOOK_URL and BOOKING_WEBHOOK_SECRET, set with
// `wrangler secret put NAME` or in the dashboard; locally `wrangler dev` reads them from .env.local.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rehan-traders-website",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-28",
  "assets": {
    "directory": "out",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  // Workers Logs: where a booking lands if the Apps Script cannot be reached.
  "observability": { "enabled": true }
}
