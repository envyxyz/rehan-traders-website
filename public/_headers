# Cloudflare static-asset headers (served for everything in out/, not for /api/*, which the Worker answers).
# HSTS is set by the Cloudflare zone (SSL/TLS > Edge Certificates), not here.
# script-src keeps 'unsafe-inline': a static export has no per-request nonce, and the inline scripts Next.js writes into every page (the RSC payload pushes) and the GTM bootstrap change with each build, so hashes would break on every deploy. Nothing else (no eval, no other host) is allowed.
# style-src keeps 'unsafe-inline' for the style="" attributes React and Motion write.
# Google: GTM loads gtm.js and the GA4 tag from googletagmanager.com; GA4 sends hits to google-analytics.com and analytics.google.com, and with Google signals also to g.doubleclick.net, google.com and the local google.com.pk (Google's documented GA4 CSP). The only frame allowed is the Google Maps embed on /visit.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://*.googletagmanager.com https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://*.googletagmanager.com https://*.google-analytics.com https://*.g.doubleclick.net https://*.google.com https://*.google.com.pk; font-src 'self'; connect-src 'self' https://cloudflareinsights.com https://*.googletagmanager.com https://*.google-analytics.com https://analytics.google.com https://*.analytics.google.com https://*.g.doubleclick.net https://*.google.com https://*.google.com.pk; frame-src https://www.google.com/maps/embed; manifest-src 'self'; media-src 'self'; worker-src 'none'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), bluetooth=(), serial=(), accelerometer=(), gyroscope=(), magnetometer=(), browsing-topics=()
  Cross-Origin-Opener-Policy: same-origin
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable
# Photos, art, sounds and icons keep the same file name when they change (no hash), so they are not immutable: a week in the
# browser, then a day more served stale while the browser refreshes it. Replace one under a new name if it must show at once.
/images/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
/art/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
/sounds/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
/icon*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
/apple-icon.png
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
/favicon.ico
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
/sitemap.xml
  Cache-Control: public, max-age=86400, s-maxage=86400
/sitemap_index.xml
  Cache-Control: public, max-age=86400, s-maxage=86400
/robots.txt
  Cache-Control: public, max-age=86400, s-maxage=86400
/llms.txt
  Cache-Control: public, max-age=86400, s-maxage=86400
/llms-full.txt
  Cache-Control: public, max-age=86400, s-maxage=86400
