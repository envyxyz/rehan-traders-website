# Copy to .env.local and fill in. Never commit real values.
OPENROUTER_API_KEY=          # chat + estimator primary (Claude Haiku) and image script
GOOGLE_AI_API_KEY=           # chat + estimator fallback (Gemini, Google AI Studio)
GOOGLE_PLACES_API_KEY=       # reviews (Places API New), server-only, restricted to Places API
GOOGLE_PLACE_ID=             # Rehan Traders place id
BOOKING_WEBHOOK_URL=         # Google Apps Script web app (Sheet + email)
BOOKING_WEBHOOK_SECRET=      # shared secret checked by the Apps Script
NEXT_PUBLIC_GA_ID=           # GA4 measurement id
NEXT_PUBLIC_SITE_URL=https://rehanmobiletraders.com
