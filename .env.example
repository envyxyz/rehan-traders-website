# Copy to .env.local and fill in. Never commit real values.
# Local: Next and `wrangler dev` both read .env.local. Production: set the Worker secrets in the Cloudflare dashboard (or `wrangler secret put NAME`).
OPENROUTER_API_KEY=          # chat + estimator primary (Claude Haiku) and image script
OPENROUTER_API_KEY_FREE=     # a free openrouter_api_key
GOOGLE_AI_API_KEY=           # chat + estimator fallback (Gemini, Google AI Studio free tier, no billing)
GOOGLE_AI_PRO_API_KEY=       # chat + estimator fallback, tried before GOOGLE_AI_API_KEY (also free tier: 20 requests a day per model, 29 Oct 2026)
GROQ_API_KEY=                # chat + estimator last model fallback (Groq free tier)
BOOKING_WEBHOOK_URL=         # Google Apps Script web app (Sheet + email)
BOOKING_WEBHOOK_SECRET=      # shared secret checked by the Apps Script
NEXT_PUBLIC_SITE_URL=https://rehanmobiletraders.com
