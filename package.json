{
  "name": "rehan-traders-website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "pnpm run --parallel \"/^dev:/\"",
    "dev:next": "next dev",
    "dev:worker": "node -e \"require('fs').mkdirSync('out',{recursive:true})\" && wrangler dev --port 8787 --show-interactive-dev-session=false",
    "preview": "pnpm build && wrangler dev --port 8787 --show-interactive-dev-session=false",
    "build": "next build && node scripts/fix-segments.mjs",
    "start": "next start",
    "lint": "eslint --max-warnings 0",
    "typecheck": "next typegen && tsc --noEmit",
    "palette": "node scripts/palette.mjs",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@ai-sdk/google": "4.0.107",
    "@ai-sdk/groq": "4.0.69",
    "@openrouter/ai-sdk-provider": "3.1.0",
    "ai": "7.0.150",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.0",
    "lenis": "^1.3.27",
    "lucide-react": "^1.62.0",
    "motion": "^14.7.1",
    "next": "16.4.3",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "shadcn": "^4.22.2",
    "sharp": "0.35.5",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "4.154.0"
  },
  "packageManager": "pnpm@11.9.0"
}
